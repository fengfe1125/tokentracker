{
	"$schema": "node_modules/wrangler/config-schema.json",

	// ⚠️ 这不是个人主页那个 Worker。主页是 restless-mountain-3c35（纯静态资源，
	// 没有 main 字段），部署在 sakuramu.edu.kg 顶级域。两者刻意分开：
	// 主页保持零 Worker 调用，且这个服务挂掉也打不垮主页。
	// 千万不要在 sakuramu-home 的 wrangler.jsonc 里加 main。
	"name": "tokentracker-stats",
	"main": "src/index.js",
	"compatibility_date": "2026-09-08",

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tokentracker-stats",
			"database_id": "7647bd67-59ab-4285-9521-6f7a1f7be4d5"
		}
	],

	"routes": [{ "pattern": "tt.sakuramu.edu.kg", "custom_domain": true }],

	"vars": {
		// open | invite | closed —— 公共实例出厂即 invite；自部署者自行放开。
		"INVITE_MODE": "closed",
		"MAX_HANDLES": "200"
	},

	"observability": { "enabled": true }
}
