<ui:FluentWindow x:Class="TokenTracker.Windows.Shell.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:TokenTracker.Windows.Localization"
                 xmlns:shell="clr-namespace:TokenTracker.Windows.Shell"
                 Title="TokenTracker" Width="1060" Height="720" MinWidth="820" MinHeight="520"
                 WindowStartupLocation="CenterScreen" WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="TokenTracker" Grid.Row="0" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧栏：视图 + 7 个工具数据源状态 + 设置 -->
            <DockPanel Grid.Column="0" Margin="0,4,0,10">
                <ListBox x:Name="SettingsNav" DockPanel.Dock="Bottom" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItem}" SelectionChanged="OnNavSelected">
                    <ListBoxItem Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Text="{l:Tr 设置}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
                <StackPanel>
                    <ListBox x:Name="MainNav" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SidebarItem}" SelectionChanged="OnNavSelected">
                        <ListBoxItem Tag="overview">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataBarVertical24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="{l:Tr 概览}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="sessions">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="{l:Tr 会话记录}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                    <TextBlock Text="{l:Tr Agent 数据源}" Style="{StaticResource Tertiary}" Margin="18,16,0,4" />
                    <ListBox x:Name="ToolNav" Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding ToolRows}" ItemContainerStyle="{StaticResource SidebarItem}"
                             SelectionChanged="OnNavSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Opacity="{Binding Opacity}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" Margin="4,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Trailing}" Style="{StaticResource Tertiary}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </DockPanel>

            <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <ContentControl x:Name="PageHost" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
